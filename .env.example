APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://morcheh:morcheh@localhost:5433/morcheh?sslmode=disable
REDIS_URL=redis://:morcheh@localhost:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:3200
# Seals stored SSH credentials. Generate your own: openssl rand -base64 32
SECRETS_KEY=

# How often every server's connection is re-checked in the background (0 = off).
SERVER_CHECK_INTERVAL=15s
# Same for storages (S3, FTP, SFTP, WebDAV).
STORAGE_CHECK_INTERVAL=30s
# Walk each storage to measure its size (0 = only on demand); check history kept.
STORAGE_SCAN_INTERVAL=24h
STORAGE_HISTORY=744h
DNS_CHECK_INTERVAL=30s
PVE_CHECK_INTERVAL=30s
# How often cloud accounts (ArvanCloud) are re-read in the background.
CLOUD_CHECK_INTERVAL=5m
# Dev only: ArvanCloud keys starting with "fake-" go to the fake API (compose test-arvan).
# ARVAN_FAKE_URL=http://127.0.0.1:8091/%s/v3
# How often the cron job scheduler looks for jobs that are due (0 = off).
SCHEDULE_TICK=15s
# Where log archives kept on this machine go (Settings › Logs & retention).
LOG_ARCHIVE_DIR=data/log-archives

# Asked for by the first-run form, so a stranger reaching a fresh install can't
# become its admin (`openssl rand -hex 24`). Set it on anything but a laptop.
SETUP_TOKEN=
# Ansible. A name on PATH or a path; not installed = the Ansible pages say so.
ANSIBLE_PLAYBOOK=ansible-playbook
# auto: bubblewrap sandbox when it works, without it only system admins can run
# playbooks. bwrap: refuse to run without it. off: never use it.
ANSIBLE_SANDBOX=auto
ANSIBLE_RUN_TIMEOUT=2h

# Believe X-Forwarded-For / X-Real-IP. Only behind a proxy that sets them.
TRUST_PROXY=false
# Send the session cookie over plain HTTP outside development.
COOKIE_INSECURE=false
