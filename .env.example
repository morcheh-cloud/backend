APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://morcheh:morcheh@localhost:5433/morcheh?sslmode=disable
REDIS_URL=redis://:morcheh@localhost:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:3200
# Seals stored SSH credentials. Generate your own: openssl rand -base64 32
SECRETS_KEY=

# How often every server's connection is re-checked in the background (0 = off).
SERVER_CHECK_INTERVAL=15s
# Same for storages (S3, FTP, SFTP, WebDAV).
STORAGE_CHECK_INTERVAL=30s

# Asked for by the first-run form, so a stranger reaching a fresh install can't
# become its admin (`openssl rand -hex 24`). Set it on anything but a laptop.
SETUP_TOKEN=
# Believe X-Forwarded-For / X-Real-IP. Only behind a proxy that sets them.
TRUST_PROXY=false
# Send the session cookie over plain HTTP outside development.
COOKIE_INSECURE=false
