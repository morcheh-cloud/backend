# Copy to .env next to compose.yml and fill in.

# Where people open the panel, and where their browser reaches the backend.
# Baked into the panel image: rebuild it (docker compose build frontend)
# after changing API_URL.
PANEL_URL=http://localhost:3200
API_URL=http://localhost:8080
PANEL_PORT=3200
BACKEND_PORT=8080

# openssl rand -hex 24 for each
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Seals every stored credential. openssl rand -base64 32. Keep a copy: losing
# it makes the saved passwords and keys unreadable.
SECRETS_KEY=
# Asked for by the first-run form (openssl rand -hex 24).
SETUP_TOKEN=

# true while the panel is served over plain http (the session cookie is
# Secure otherwise). Put it behind https and set false.
COOKIE_INSECURE=true
# true only behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# auto | bwrap | off (see compose.yml about the sandbox)
ANSIBLE_SANDBOX=auto
TZ=UTC
